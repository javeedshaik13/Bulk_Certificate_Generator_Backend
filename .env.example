# Application Configuration
APP_NAME="Bulk Certificate Generator API"
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database Configuration (SQLite default, PostgreSQL supported)
DATABASE_URL=sqlite:///./certificates.db
# For PostgreSQL: DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/certificate_db

# File Storage Configuration
STORAGE_BACKEND=local
STORAGE_BASE_DIR=./storage/certificates
MAX_CONCURRENT_WORKERS=4
MAX_RECIPIENTS_PER_JOB=1000

# CORS Configuration
CORS_ORIGINS=["*"]
